APP_URL=http://127.0.0.1:3000
# Use an absolute path shared by web and worker in production.
SELLIO_DB=./data/sellio.sqlite
# Generate a different 32-byte base64 secret for each deployment.
SELLIO_ENCRYPTION_KEY=
OWNER_EMAIL=
# Generate a random code of at least 32 characters. Remove after assigning the owner.
OWNER_BOOTSTRAP_SECRET=
NEXT_PUBLIC_CONTACT_EMAIL=
SMTP_URL=
MAIL_FROM=
# Explicit opt-ins. These local modes are disabled in production.
SELLIO_DEV_MAIL=console
SELLIO_PAYMENT_MODE=test

YANDEX_MAPS_KEY=
YANDEX_MAPS_CRM_ALLOWED=false
YANDEX_MAPS_CSV_ALLOWED=false
TWO_GIS_KEY=
TWO_GIS_CRM_ALLOWED=false
TWO_GIS_CSV_ALLOWED=false
TWO_GIS_CONTACTS_ALLOWED=false
GOOGLE_MAPS_KEY=
GOOGLE_MAPS_CRM_ALLOWED=false
GOOGLE_MAPS_CSV_ALLOWED=false
SEARCH_REQUESTS_PER_SOURCE_PER_MINUTE=5

GGSEL_SELLER_API_ALLOWED=false
PLATI_SELLER_API_ALLOWED=false
